{
  "name": "git-visualization-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Git可视化工具 — 开源 Git 图形化桌面客户端",
  "author": "Git可视化工具",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n web,app -c green,magenta \"vite\" \"wait-on http://127.0.0.1:5173 && GIT_VIZ_DEV=1 electron .\"",
    "dev:web": "concurrently -k -n server,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:electron && tsc -p tsconfig.server.json && vite build",
    "start": "electron .",
    "start:web": "NODE_ENV=production node dist/server/index.js",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "eslint": "^9.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.gitviz.desktop",
    "productName": "Git可视化工具",
    "executableName": "git-visualization-tool",
    "copyright": "Copyright © Git可视化工具",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Git可视化工具"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Git可视化工具"
    }
  }
}
